#!/usr/bin/env bash

# Pre-commit hook: run SwiftLint on staged Swift files
# Skip with: git commit --no-verify

SWIFTLINT=$(command -v swiftlint || echo "")

if [ -z "$SWIFTLINT" ]; then
    # Check common Homebrew paths for GUI/non-login shells
    for candidate in /opt/homebrew/bin/swiftlint /usr/local/bin/swiftlint; do
        if [ -x "$candidate" ]; then
            SWIFTLINT="$candidate"
            break
        fi
    done
fi

if [ -z "$SWIFTLINT" ]; then
    echo "warning: SwiftLint not installed, skipping lint check."
    echo "  Install with: brew install swiftlint"
    exit 0
fi

# Only lint staged Swift files
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.swift')

if [ -z "$STAGED_SWIFT_FILES" ]; then
    exit 0
fi

echo "Running SwiftLint --fix on staged Swift files..."

# Auto-fix what we can, then re-stage the fixed files
FIXED=0
while IFS= read -r file; do
    if [ -f "$file" ]; then
        "$SWIFTLINT" lint --fix --quiet "$file" 2>/dev/null
        git add "$file"
        FIXED=1
    fi
done <<< "$STAGED_SWIFT_FILES"

if [ $FIXED -ne 0 ]; then
    echo "SwiftLint auto-fixed some issues and re-staged files."
fi

# Now lint strictly to catch anything that couldn't be auto-fixed
echo "Running SwiftLint --strict on staged Swift files..."

LINT_ERRORS=0
while IFS= read -r file; do
    if [ -f "$file" ]; then
        "$SWIFTLINT" lint --strict --quiet "$file"
        if [ $? -ne 0 ]; then
            LINT_ERRORS=1
        fi
    fi
done <<< "$STAGED_SWIFT_FILES"

if [ $LINT_ERRORS -ne 0 ]; then
    echo ""
    echo "SwiftLint found violations that could not be auto-fixed."
    echo "  To skip this check: git commit --no-verify"
    exit 1
fi

exit 0
