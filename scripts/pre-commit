#!/usr/bin/env bash

# Pre-commit hook: run SwiftLint on staged Swift files
# Skip with: git commit --no-verify

SWIFTLINT=$(command -v swiftlint || echo "")

if [ -z "$SWIFTLINT" ]; then
    # Check common Homebrew paths for GUI/non-login shells
    for candidate in /opt/homebrew/bin/swiftlint /usr/local/bin/swiftlint; do
        if [ -x "$candidate" ]; then
            SWIFTLINT="$candidate"
            break
        fi
    done
fi

if [ -z "$SWIFTLINT" ]; then
    echo "warning: SwiftLint not installed, skipping lint check."
    echo "  Install with: brew install swiftlint"
    exit 0
fi

# Only lint staged Swift files under macos/
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'macos/**.swift')

if [ -z "$STAGED_SWIFT_FILES" ]; then
    exit 0
fi

echo "Running SwiftLint on staged Swift files..."

cd macos || exit 0

LINT_ERRORS=0
while IFS= read -r file; do
    # Strip the macos/ prefix since we cd'd into it
    relative="${file#macos/}"
    if [ -f "$relative" ]; then
        "$SWIFTLINT" lint --strict --quiet "$relative"
        if [ $? -ne 0 ]; then
            LINT_ERRORS=1
        fi
    fi
done <<< "$STAGED_SWIFT_FILES"

if [ $LINT_ERRORS -ne 0 ]; then
    echo ""
    echo "SwiftLint found violations. Fix them before committing."
    echo "  To skip this check: git commit --no-verify"
    exit 1
fi

exit 0
